# Пароль для входа в админку (/admin)
NUXT_ADMIN_PASSWORD=change-me
# Секрет для шифрования сессии, минимум 32 символа (например: openssl rand -hex 32)
NUXT_SESSION_SECRET=
# Публичный адрес сайта (для canonical и Open Graph)
NUXT_PUBLIC_SITE_URL=https://example.com
# Восстановление пароля: бот присылает ссылку для смены пароля в этот чат
NUXT_TELEGRAM_BOT_TOKEN=
NUXT_TELEGRAM_CHAT_ID=
